def calculate_statistics(*args):
    count = len(args)
    total = sum(args)
    avg = total / count if count > 0 else 0
    return (count, total, avg)

def update_student_records(records, bonus):
    updated = []
    for name, grade in records:
        updated.append((name, grade + bonus))
    return updated

# Test data
students = [("Alice", 85), ("Bob", 90), ("Charlie", 78)]

stats = calculate_statistics(85, 90, 78)
print("Stats:", stats)

updated_students = update_student_records(students, 5)
print("Updated Records:", updated_students)

